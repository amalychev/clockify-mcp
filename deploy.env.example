# Settings for ./deploy.sh — copy to deploy.env on the server and adjust.
# deploy.env is git-ignored, so server-specific values stay on the server.

# Use "sudo docker" if your user is not in the docker group
DOCKER=docker

# Image and container names.
# With docker-compose.yml present, deploy.sh drives Compose — and Compose names
# the container itself, usually <project>-<service>-1. Check `docker ps` and put
# that exact name here, or the health check and --page-only address nothing.
IMAGE=clockify-mcp
CONTAINER=clockify-mcp-app-1
COMPOSE_SERVICE=app

# Published port on the host; the reverse proxy points at this one
HOST_PORT=8080
CONTAINER_PORT=8080

# Branch to deploy
BRANCH=main

# Runtime configuration passed into the container (CLOCKIFY_ALLOWED_INSTANCES, …)
ENV_FILE=.env

# Health check after the swap; a failure rolls back to the previous image
HEALTH_URL=http://127.0.0.1:8080/health
HEALTH_RETRIES=30
HEALTH_DELAY=1

# Checked at the end to confirm the public site really serves the new page
PUBLIC_URL=https://clockify-mcp.webapace.ink/

# Cloudflare cache purge — needs a token with the Zone.Cache Purge permission.
# Leave empty to skip.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
