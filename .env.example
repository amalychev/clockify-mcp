# Copy to .env and fill in. Only CLOCKIFY_API_KEY is required.

# --- required -----------------------------------------------------------------

# Clockify → Profile settings → API → Generate
CLOCKIFY_API_KEY=

# --- workspace and isolation --------------------------------------------------

# Default workspace. Without it, the one your account is currently active in.
# CLOCKIFY_WORKSPACE_ID=

# true confines every tool to CLOCKIFY_WORKSPACE_ID and refuses anything wider.
# CLOCKIFY_WORKSPACE_LOCK=false

# true refuses every tool that would change something.
# CLOCKIFY_READ_ONLY=false

# --- times --------------------------------------------------------------------

# IANA zone for wall-clock arguments such as "09:00".
# Defaults to the zone on the Clockify profile.
# CLOCKIFY_TIMEZONE=Europe/Zurich

# --- hosted mode --------------------------------------------------------------

# http starts the HTTP transport instead of stdio.
# MCP_TRANSPORT=http
# PORT=8080
# HOST=0.0.0.0

# Comma-separated hosts a hosted deployment may target. Leave empty to allow any
# public host; private addresses are refused either way.
# CLOCKIFY_ALLOWED_INSTANCES=api.clockify.me

# --- other --------------------------------------------------------------------

# On-premise installations only: the main API root. The reports and time-off
# roots are derived from it unless set explicitly.
# CLOCKIFY_API_URL=https://api.clockify.me/api/v1
# CLOCKIFY_REPORTS_URL=
# CLOCKIFY_PTO_URL=

# bearer sends the key as `Authorization: Bearer` instead of `X-Api-Key`.
# CLOCKIFY_AUTH_TYPE=api-key

# Per-request timeout in milliseconds.
# CLOCKIFY_TIMEOUT_MS=60000
